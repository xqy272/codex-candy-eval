{
  "manifestVersion": 2,
  "name": "codex-candy-eval",
  "publisher": "cloudops",
  "displayName": "模型测试",
  "version": "1.4.2",
  "description": "糖果题、模型指纹和画鹈鹕测试",
  "license": "MIT",
  "engines": {
    "codex-proxy-rs": ">=3.43.1, <3.45.0"
  },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "contributes": {
    "management": {
      "version": 2
    },
    "maintenance": {
      "version": 1
    }
  },
  "configurationSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "resources": {
    "web/index.html": "text/html",
    "web/app.js": "text/javascript",
    "web/app.css": "text/css",
    "web/fonts/inter-latin-wght-normal.woff2": "font/woff2",
    "web/fonts/jetbrains-mono-latin-wght-normal.woff2": "font/woff2",
    "data/unified_bank.json": "application/json",
    "data/shared_detector.bin": "application/octet-stream",
    "LICENSE": "text/plain",
    "vendor/SOURCES.json": "application/json",
    "licenses/candy-eval.txt": "text/plain",
    "licenses/codex-proxy-ui.txt": "text/plain",
    "licenses/dompurify.txt": "text/plain",
    "licenses/inter.txt": "text/plain",
    "licenses/jetbrains-mono.txt": "text/plain",
    "licenses/gateway-plugin-sdk.txt": "text/plain",
    "licenses/lm-detector.txt": "text/plain",
    "licenses/vue.txt": "text/plain",
    "licenses/katex.txt": "text/plain",
    "licenses/marked.txt": "text/plain",
    "licenses/marked-alert.txt": "text/plain"
  },
  "state": [
    {
      "namespace": "history",
      "schemaVersion": 2,
      "schema": {
        "type": "object",
        "required": [
          "records"
        ],
        "properties": {
          "records": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      },
      "maximumRecords": 1,
      "maximumBytes": 262144,
      "maximumValueBytes": 262144,
      "migratesFrom": [
        1
      ]
    },
    {
      "namespace": "details",
      "schemaVersion": 1,
      "schema": {
        "type": "object",
        "required": [
          "record"
        ],
        "properties": {
          "record": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "maximumRecords": 256,
      "maximumBytes": 16777216,
      "maximumValueBytes": 262144,
      "migratesFrom": []
    },
    {
      "namespace": "tasks",
      "schemaVersion": 1,
      "schema": {
        "type": "object"
      },
      "maximumRecords": 128,
      "maximumBytes": 4194304,
      "maximumValueBytes": 262144,
      "migratesFrom": []
    },
    {
      "namespace": "samples",
      "schemaVersion": 1,
      "schema": {
        "type": "object"
      },
      "maximumRecords": 1024,
      "maximumBytes": 16777216,
      "maximumValueBytes": 262144,
      "migratesFrom": []
    },
    {
      "namespace": "queue",
      "schemaVersion": 1,
      "schema": {
        "type": "object"
      },
      "maximumRecords": 1,
      "maximumBytes": 262144,
      "maximumValueBytes": 262144,
      "migratesFrom": []
    },
    {
      "namespace": "batches",
      "schemaVersion": 1,
      "schema": {
        "type": "object"
      },
      "maximumRecords": 129,
      "maximumBytes": 4194304,
      "maximumValueBytes": 262144,
      "migratesFrom": []
    }
  ]
}
